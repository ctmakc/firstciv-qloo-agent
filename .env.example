# Qloo hackathon credential (server-side only; never commit a real value)
QLOO_API_KEY=
# Hackathon gateway. The harness only sends the key to a custom base URL that is explicitly trusted.
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com

# Optional LLM planner: any OpenAI-compatible /chat/completions endpoint with tool calling.
# Comma-separated models: the next one takes over if one keeps failing.
AI_BASE_URL=https://ollama.com/v1
AI_MODEL=gemma4:31b,gpt-oss:120b
AI_API_KEY=

# Optional tuning
# PORT=8795
# QLOO_MAX_PARALLEL=3
# QLOO_CACHE_TTL_H=72
# RUNS_PER_IP=12
# MAX_CONCURRENT_RUNS=4
